# 이 파일은 커밋됩니다. 실제 비밀값은 넣지 말고, 로컬은 .env.local, 배포는 Dokploy Environment를 사용하세요.

# ── Matter Server (server-only, NEXT_PUBLIC_ 붙이지 말 것) ──
MATTER_SERVER_URL=ws://192.168.0.100:5580/ws

# ── 임시 로그인 계정 (추후 실제 인증으로 대체 예정) ──
# 비어 있으면 로그인이 비활성화됩니다(fail closed).
AUTH_USERNAME=admin
AUTH_PASSWORD=
# 세션 쿠키 서명 키. 생성: openssl rand -hex 32  (프로덕션 필수)
AUTH_SECRET=

# ── DB (Phase 1 미사용, 추후 인증/영속화용) ──
# dev(개발 PC):  postgresql://matter:<password>@192.168.0.100:5433/matter
# prod(dokploy): postgresql://matter:<password>@matter-db:5432/matter
DATABASE_URL=
